{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/I${workspaceFolder}\\vcpkg\\installed\\x64-windows\\include",

                "${workspaceFolder}\\main.cpp",
                "${workspaceFolder}\\control\\Train.cpp",
                "${workspaceFolder}\\control\\Service.cpp",
                "${workspaceFolder}\\control\\Track.cpp",
                "${workspaceFolder}\\control\\Signal.cpp",

                "/Fe${workspaceFolder}\\main.exe",

                "/link",
                "/LIBPATH:${workspaceFolder}\\vcpkg\\installed\\x64-windows\\lib",
                "yaml-cpp.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}